### 66. E3 对照：同一样本集比较 pure 与 hybrid
# @name comparisonE3
POST {{baseUrl}}/api/attack/comparisons
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"experiment_type":"E3","arms":[{"arm_role":"pure","manifest":{"sample_set_version":"{{originalSampleSetVersion}}","verify_mode":"fast","experiment_mode":"pure","rule_version":"{{activeRuleVersion}}","threshold_version":"{{activeThresholdVersion}}","semantic_config_version":"{{activeSemanticVersion}}","transform_dict_version":"{{activeTransformVersion}}","list_version":"{{activeListVersion}}","retriever_version":{{retrieverVersionJson}},"model_provider":null,"model_name":null,"defense_flag":false}},{"arm_role":"hybrid","manifest":{"sample_set_version":"{{originalSampleSetVersion}}","verify_mode":"fast","experiment_mode":"hybrid","rule_version":"{{activeRuleVersion}}","threshold_version":"{{activeThresholdVersion}}","semantic_config_version":"{{activeSemanticVersion}}","transform_dict_version":"{{activeTransformVersion}}","list_version":"{{activeListVersion}}","retriever_version":{{retrieverVersionJson}},"model_provider":null,"model_name":null,"defense_flag":false}}]}

