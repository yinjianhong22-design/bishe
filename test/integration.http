### 69. E5 对照：同一注入样本集只能切换 defense_flag
# @name comparisonE5
POST {{baseUrl}}/api/attack/comparisons
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"experiment_type":"E5","arms":[{"arm_role":"defense_off","manifest":{"sample_set_version":"{{injectionSampleSetVersion}}","verify_mode":"enhanced","experiment_mode":"defense_off","rule_version":"{{activeRuleVersion}}","threshold_version":"{{activeThresholdVersion}}","semantic_config_version":"{{activeSemanticVersion}}","transform_dict_version":"{{activeTransformVersion}}","list_version":"{{activeListVersion}}","retriever_version":{{retrieverVersionJson}},"model_provider":null,"model_name":null,"defense_flag":false}},{"arm_role":"defense_on","manifest":{"sample_set_version":"{{injectionSampleSetVersion}}","verify_mode":"enhanced","experiment_mode":"defense_on","rule_version":"{{activeRuleVersion}}","threshold_version":"{{activeThresholdVersion}}","semantic_config_version":"{{activeSemanticVersion}}","transform_dict_version":"{{activeTransformVersion}}","list_version":"{{activeListVersion}}","retriever_version":{{retrieverVersionJson}},"model_provider":null,"model_name":null,"defense_flag":true}}]}

> {%
client.test("E5 必须使用同一注入集且仅切换防御开关", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    const off = d.arms.find(a => a.arm_role === "defense_off");
    const on = d.arms.find(a => a.arm_role === "defense_on");
    client.assert(off && on, "E5 防御两臂不完整");
    client.assert(off.manifest.sample_set_version === on.manifest.sample_set_version, "E5 样本集不同");
    client.assert(off.manifest.defense_flag === false && on.manifest.defense_flag === true, "E5 防御开关设置错误");
    client.assert(d.metrics.injection_asr_by_arm !== undefined, "E5 缺少注入 ASR 指标");
});
client.global.set("comparisonE5Id", response.body.data.comparison_id);
%}

