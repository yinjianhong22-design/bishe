Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
client.test("看板必须返回趋势、风险分布、骗局分布和规则命中", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    ["detection_trend","risk_distribution","fraud_type_distribution","rule_hits"].forEach(k =>
        client.assert(Array.isArray(d[k]), `看板缺少 ${k}`));
    d.rule_hits.forEach(r => {
        client.assert(r.hit_rate >= 0 && r.hit_rate <= 1, "命中率越界");
        if (r.trace_count > 0) client.assert(Math.abs(r.hit_rate - r.matched_count / r.trace_count) < 0.0001, "命中率无法由分子分母复算");
    });
});
%}

