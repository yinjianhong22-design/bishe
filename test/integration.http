### 63. P1 盲区矩阵：检出率必须能由计数复算
# @name blindspots
GET {{baseUrl}}/api/attack/replays/{{replayRunId}}/blindspots
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
client.test("盲区矩阵不得把失败样本当作未检出，检出率必须可复算", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(Array.isArray(response.body.data), "盲区 data 必须为数组");
    response.body.data.forEach(c => {
        client.assert(c.total_count >= 1 && c.detected_count <= c.total_count, "盲区计数异常");
        client.assert(Math.abs(c.detection_rate - c.detected_count / c.total_count) < 0.0001, "盲区检出率无法复算");
    });
});
%}

