### 21. 规则发布准备：读取当前完整生效集合，不能只发布新增规则
# @name getActiveRuleRelease
GET {{baseUrl}}/api/rule-releases/{{activeRuleVersion}}
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
client.test("当前规则发布单必须可读且包含完整快照", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.status === "active" && Array.isArray(d.items), "当前发布单不是有效快照");
});
client.global.set("activeReleaseItems", response.body.data.items);
%}

### 22. P0 创建规则草稿：规则不直接生效
# @name createRule
POST {{baseUrl}}/api/rules
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"fraud_type":"impersonation","weight":40,"exclusive_group":null,"priority":0,"conditions":{"all":[{"field":"text","op":"contains_any","value":["INTEGRATION_TEST_RULE"]},{"field":"text","op":"contains_any","value":["集成测试专用"]}]},"explanation":"命中集成测试专用的两个独立条件。","enabled":true}

> {%
client.test("新规则必须处于草稿阶段且由服务端生成 rule_id", function () {
    const d = response.body.data;
    client.assert(response.status === 201, `期望 201，实际 ${response.status}`);
    client.assert(/^R[0-9]+$/.test(d.rule_id), "规则编号格式错误");
    client.assert(d.revision === 1 && d.current_version_id === null, "草稿不能直接成为生效版本");
});
client.global.set("ruleId", response.body.data.rule_id);
client.global.set("ruleRevision", response.body.data.revision);
%}

### 23. P0 按 revision 修改草稿：验证乐观锁正常路径
# @name updateRuleDraft
PUT {{baseUrl}}/api/rules/{{ruleId}}/draft
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"revision":{{ruleRevision}},"fraud_type":"impersonation","weight":45,"exclusive_group":null,"priority":0,"conditions":{"all":[{"field":"text","op":"contains_any","value":["INTEGRATION_TEST_RULE"]},{"field":"text","op":"contains_any","value":["集成测试专用"]}]},"explanation":"命中集成测试专用的两个独立条件，权重为 45。","enabled":true}

> {%
client.test("正确 revision 必须能更新草稿并递增版本号", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.revision > client.global.get("ruleRevision"), "revision 未递增");
    client.assert(d.draft.weight === 45, "草稿权重未更新");
});
client.global.set("ruleRevision", response.body.data.revision);
%}

### 24. 并发边界：过期 revision 不能覆盖他人修改
# @name staleRuleDraft
PUT {{baseUrl}}/api/rules/{{ruleId}}/draft
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"revision":1,"fraud_type":"impersonation","weight":1,"conditions":{"all":[{"field":"text","op":"contains_any","value":["STALE_WRITE"]}]},"explanation":"过期写入应被拒绝。","enabled":true}

> {%
client.test("过期 revision 必须返回 409", function () {
    client.assert(response.status === 409, `期望 409，实际 ${response.status}`);
});
%}

### 25. P0 冻结不可变规则版本，并组装完整发布集合
# @name createRuleVersion
POST {{baseUrl}}/api/rules/{{ruleId}}/versions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"revision":{{ruleRevision}}}

> {%
client.test("冻结版本必须保留草稿条件和权重", function () {
    const d = response.body.data;
    client.assert(response.status === 201, `期望 201，实际 ${response.status}`);
    client.assert(d.rule_id === client.global.get("ruleId"), "规则版本关联错误");
    client.assert(d.weight === 45 && d.enabled === true, "冻结内容不是最新草稿");
});
client.global.set("ruleVersionId", response.body.data.rule_version_id);
const items = (client.global.get("activeReleaseItems") || []).map(i => ({
    rule_version_id: i.rule_version_id,
    enabled: i.enabled
}));
items.push({rule_version_id: response.body.data.rule_version_id, enabled: true});
client.global.set("releaseItemsJson", JSON.stringify(items));
%}

### 26. P0 创建规则发布单：保留全部旧规则并加入新版本
# @name createRuleRelease
POST {{baseUrl}}/api/rule-releases
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"items":{{releaseItemsJson}}}

> {%
client.test("发布单必须包含完整目标集合且初始为 draft", function () {
    const d = response.body.data;
    client.assert(response.status === 201, `期望 201，实际 ${response.status}`);
    client.assert(d.status === "draft", "新发布单不能直接激活");
    client.assert(d.items.some(i => i.rule_id === client.global.get("ruleId")), "发布集合遗漏新规则");
    client.assert(d.items.length === (client.global.get("activeReleaseItems") || []).length + 1, "发布集合不是完整快照");
});
client.global.set("newRuleReleaseVersion", response.body.data.version);
%}

