### 61. P1 临时单臂回放：计数必须能以有效样本对账
# @name createReplay
POST {{baseUrl}}/api/attack/replays
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"experiment_type":"ad_hoc","manifest":{"sample_set_version":"{{variantSampleSetVersion}}","verify_mode":"fast","experiment_mode":"single","rule_version":"{{activeRuleVersion}}","threshold_version":"{{activeThresholdVersion}}","semantic_config_version":"{{activeSemanticVersion}}","transform_dict_version":"{{activeTransformVersion}}","list_version":"{{activeListVersion}}","retriever_version":{{retrieverVersionJson}},"model_provider":null,"model_name":null,"defense_flag":false}}

> {%
client.test("回放必须返回逐条真实结果，失败样本不能计入未检出", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.total_count === d.valid_count + d.failed_count, "回放总数无法对账");
    client.assert(d.detected_count <= d.valid_count, "检出数超过有效样本数");
    client.assert(d.items.length === d.total_count, "逐条结果数量不完整");
    d.items.forEach(i => {
        if (i.status === "failed") client.assert(i.trace_id === null && i.error_code, "失败项必须无轨迹且有错误码");
        else client.assert(i.trace_id && typeof i.detected === "boolean", "成功项必须有真实轨迹和检出结果");
    });
});
client.global.set("replayRunId", response.body.data.replay_run_id);
const missed = response.body.data.items.filter(i => i.status !== "failed" && i.detected === false).map(i => i.sample_id);
client.global.set("missedSampleIdsJson", JSON.stringify(missed));
client.global.set("missedSampleCount", missed.length);
%}

