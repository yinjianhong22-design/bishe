# 反诈信息核验与风险解释系统——REST Client 集成测试
#
# 使用方法：
# 1. 安装 VS Code 插件 REST Client（humao.rest-client），启动后端到 http://localhost:8000。
# 2. 修改下面的运营账号和密码；不要在仓库中填写真实密码。
# 3. 在隔离测试环境按文件顺序执行。脚本会新增规则、案例、名单和配置并激活版本。
# 4. 前置数据：一套已激活的规则/阈值/语义/变形词表/名单版本，以及运营账号。
# 5. P1 攻防、P2 智能体需要对应功能已启用；批量 CSV 约定表头为 content_type,content。
#
# 断言风格：每个测试都针对一个可观察的生产缺陷，而非只检查“接口能通”。

@baseUrl = http://localhost:8000
@operatorUsername = operator
@operatorPassword = CHANGE_ME
@dashboardStart = 2000-01-01T00:00:00Z
@dashboardEnd = 2100-01-01T00:00:00Z

### 01. 运营登录：签发 operator JWT，后续管理接口复用
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/x-www-form-urlencoded

grant_type=password&username={{operatorUsername}}&password={{operatorPassword}}

> {%
client.test("登录必须返回运营角色和可用 Bearer Token", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(response.body.code === "OK", "响应码不是 OK");
    client.assert(response.body.data.role === "operator", "测试账号必须是 operator");
    client.assert(response.body.data.token_type === "bearer", "token_type 必须为 bearer");
    client.assert(response.body.data.access_token.length >= 20, "访问令牌长度异常");
});
client.global.set("accessToken", response.body.data.access_token);
%}

### 02. 认证边界：管理接口不能在未登录时泄露规则数据
# @name unauthorizedRules
GET {{baseUrl}}/api/rules
Accept: application/json

> {%
client.test("未认证访问规则库必须返回 401", function () {
    client.assert(response.status === 401, `期望 401，实际 ${response.status}`);
    client.assert(response.body.code !== "OK", "失败响应不能伪装成成功");
});
%}

### 03. 输入校验：非法内容类型必须被 Pydantic 拒绝
# @name invalidVerification
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"email","content":"测试","mode":"fast"}

> {%
client.test("不支持的 content_type 必须返回 422", function () {
    client.assert(response.status === 422, `期望 422，实际 ${response.status}`);
    client.assert(response.body.details !== undefined, "校验失败必须返回 details");
});
%}

### 04. 输入校验：客户端不能注入风险分或操作键
# @name forgedScore
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"sms","content":"请立即转账","mode":"fast","risk_score":100,"operation_key":"forged"}

> {%
client.test("伪造 risk_score/operation_key 必须返回 422", function () {
    client.assert(response.status === 422, `期望 422，实际 ${response.status}`);
});
%}

### 05. P0 单条快检：保存轨迹凭据和各配置版本
# @name verifyFast
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"sms","content":"【官方客服】您的账户异常，请立即转账到安全账户，联系电话 400-000-0000。","mode":"fast"}

> {%
client.test("fast 核验必须返回完整、服务端生成的风险结果", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(response.body.code === "OK", "响应码不是 OK");
    client.assert(d.mode === "fast", "响应模式必须为 fast");
    client.assert(d.trace_id && d.trace_token.length >= 32, "必须签发轨迹 ID 和一次性返回的访问凭据");
    client.assert(["安全","低风险","中风险","高风险"].includes(d.risk_level), "风险等级不在枚举内");
    client.assert(d.total_score >= 0 && d.total_score <= 100, "风险分越界");
    client.assert(Array.isArray(d.hits) && Array.isArray(d.degraded), "hits/degraded 必须为数组");
    client.assert(d.versions.rule_version && d.versions.threshold_version, "缺少配置版本证据");
    if (d.hits.length === 0) {
        client.assert(d.total_score === 0 && d.risk_level === "安全", "无规则命中时必须强制 0 分安全");
    }
    client.assert(response.responseTime < 500, "fast 核验超过 500 毫秒性能要求");
});
client.global.set("traceId", response.body.data.trace_id);
client.global.set("traceToken", response.body.data.trace_token);
client.global.set("activeRuleVersion", response.body.data.versions.rule_version);
client.global.set("activeThresholdVersion", response.body.data.versions.threshold_version);
client.global.set("activeSemanticVersion", response.body.data.versions.semantic_config_version);
client.global.set("activeTransformVersion", response.body.data.versions.transform_dict_version);
client.global.set("activeListVersion", response.body.data.versions.list_version);
client.global.set("retrieverVersionJson", JSON.stringify(response.body.data.versions.retriever_version));
%}

### 06. P0 轨迹回放：证据坐标和评分公式必须可复核
# @name getTrace
GET {{baseUrl}}/api/verify/{{traceId}}
X-Trace-Token: {{traceToken}}
Accept: application/json

> {%
client.test("轨迹必须保留原文、配置版本和可回指原文的证据", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.trace_id === client.global.get("traceId"), "返回了其他轨迹");
    client.assert(d.original_text.includes("安全账户"), "原始文本未完整保存");
    client.assert(d.content_type === "sms" && d.verify_mode === "fast", "核验上下文缺失");
    d.hits.forEach(h => h.evidence.forEach(e => {
        client.assert(d.original_text.substring(e.start, e.end) === e.text,
            `证据坐标不能回指原文：${h.rule_id}`);
        client.assert(e.end > e.start, "证据 span 必须非空");
    }));
    const s = d.score_detail;
    client.assert(Math.abs(s.semantic_score - s.semantic_raw * s.semantic_coefficient) < 0.0001,
        "semantic_score 不符合配置换算公式");
    client.assert(Math.abs(s.total_score - Math.min(100, s.rule_score + s.semantic_score)) < 0.0001,
        "total_score 不符合服务端评分公式");
});
client.global.set("traceRuleIds", response.body.data.hits.map(h => h.rule_id));
client.global.set("traceCaseIds", response.body.data.similar_cases.map(c => c.case_id));
%}

### 07. 凭据边界：伪造 trace_token 不能读取轨迹
# @name traceWithInvalidToken
GET {{baseUrl}}/api/verify/{{traceId}}
X-Trace-Token: 00000000000000000000000000000000
Accept: application/json

> {%
client.test("错误 trace_token 必须返回 401", function () {
    client.assert(response.status === 401, `期望 401，实际 ${response.status}`);
});
%}

### 08. 准备第二条轨迹，用于跨资源凭据测试
# @name verifyOther
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"chat","content":"明天上午十点正常开会。","mode":"fast"}

> {%
client.test("第二条核验必须成功", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
});
client.global.set("otherTraceId", response.body.data.trace_id);
%}

### 09. 凭据边界：一个轨迹的 Token 不能读取另一个轨迹
# @name crossTraceToken
GET {{baseUrl}}/api/verify/{{otherTraceId}}
X-Trace-Token: {{traceToken}}
Accept: application/json

> {%
client.test("跨 trace_id 使用 Token 必须被拒绝", function () {
    client.assert(response.status === 401, `期望 401，实际 ${response.status}`);
});
%}

### 10. P0 增强核验：LLM 不可用也必须明确降级而非中断
# @name verifyEnhanced
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"sms","content":"刷单兼职，先垫付后返利，请添加客服微信。","mode":"enhanced"}

> {%
client.test("enhanced 模式必须返回判定或显式降级", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.mode === "enhanced", "响应模式必须为 enhanced");
    client.assert(Array.isArray(d.degraded), "缺少降级信息");
    client.assert(response.responseTime < 3000, "增强核验超过 3 秒预算");
    if (d.hits.length === 0) {
        client.assert(d.total_score === 0 && d.risk_level === "安全", "无命中保护在 enhanced 模式失效");
    }
});
client.global.set("enhancedTraceId", response.body.data.trace_id);
client.global.set("enhancedTraceToken", response.body.data.trace_token);
%}

### 11. P1 用户版解释：生成内容必须绑定当前轨迹
# @name explainUser
POST {{baseUrl}}/api/verify/{{traceId}}/explanation
X-Trace-Token: {{traceToken}}
Content-Type: application/json

{"view":"user"}

> {%
client.test("用户解释必须非空，引用只能来自本次规则或案例证据", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.view === "user" && d.trace_id === client.global.get("traceId"), "解释绑定了错误轨迹");
    client.assert(d.content.length > 0, "解释内容为空");
    client.assert(["template","llm"].includes(d.source), "解释来源不明确");
    client.assert(["not_checked","passed","fallback"].includes(d.citation_status), "引用状态不在枚举内");
    const refs = d.content.match(/[RC]-?[0-9]+/g) || [];
    const allowed = (client.global.get("traceRuleIds") || []).concat(client.global.get("traceCaseIds") || []);
    refs.forEach(ref => client.assert(allowed.includes(ref.replace("-", "")), `解释出现无证据引用 ${ref}`));
});
%}

### 12. P1 技术版解释：必须保留规则证据视角
# @name explainTechnical
POST {{baseUrl}}/api/verify/{{traceId}}/explanation
X-Trace-Token: {{traceToken}}
Content-Type: application/json

{"view":"technical"}

> {%
client.test("技术解释必须返回 technical 视图且不允许修改判定", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.view === "technical", "解释视图错误");
    client.assert(d.content.length > 0, "技术解释为空");
});
%}

### 13. P0 批量核验：两条 CSV 均应得到逐条结果
# @name verifyBatch
POST {{baseUrl}}/api/verify/batch
Content-Type: multipart/form-data; boundary=----AntiFraudBoundary

------AntiFraudBoundary
Content-Disposition: form-data; name="file"; filename="batch.csv"
Content-Type: text/csv

content_type,content
sms,"刷单兼职，先垫付后返利"
chat,"明天上午十点正常开会"
------AntiFraudBoundary
Content-Disposition: form-data; name="mode"

fast
------AntiFraudBoundary--

> {%
client.test("批量核验必须完整对账，单条结果不能丢失", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.item_count === 2 && d.items.length === 2, "批量条目数不一致");
    client.assert(d.items[0].item_no === 1 && d.items[1].item_no === 2, "条目顺序或编号错误");
    client.assert(d.batch_token.length >= 32, "缺少批量访问凭据");
    client.assert(d.safe_count + d.low_count + d.medium_count + d.high_count + d.failed_count === 2,
        "风险等级与失败计数无法对账");
});
client.global.set("batchId", response.body.data.batch_id);
client.global.set("batchToken", response.body.data.batch_token);
%}

### 14. P0 批量查询：不能重复发放 batch_token
# @name getBatch
GET {{baseUrl}}/api/verify/batch/{{batchId}}
X-Batch-Token: {{batchToken}}
Accept: application/json

> {%
client.test("批量详情可恢复查询，但不能再次返回 capability token", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(response.body.data.batch_id === client.global.get("batchId"), "批量 ID 不一致");
    client.assert(response.body.data.items.length === 2, "批量详情条目缺失");
    client.assert(!JSON.stringify(response.body).includes("batch_token"), "查询响应重复发放了 batch_token");
});
%}

### 15. P0 创建上线案例：为知识库公开浏览准备数据
# @name createCase
POST {{baseUrl}}/api/admin/knowledge/cases
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"fraud_type":"impersonation","title":"集成测试：冒充客服案例","content":"骗子冒充客服，以账户异常为由要求受害人转账到所谓安全账户。","advice":"不要转账，通过官方 App 或官方客服电话独立核实。","source_url":"https://example.com/integration-case","status":"published"}

> {%
client.test("运营必须能创建带真实来源的上线案例", function () {
    const d = response.body.data;
    client.assert(response.status === 201, `期望 201，实际 ${response.status}`);
    client.assert(/^C[0-9]+$/.test(d.case_id), "案例编号格式错误");
    client.assert(d.status === "published" && d.revision === 1, "案例状态或初始 revision 错误");
});
client.global.set("caseId", response.body.data.case_id);
client.global.set("caseRevision", response.body.data.revision);
%}

### 16. P0 匿名读取上线案例
# @name getPublicCase
GET {{baseUrl}}/api/knowledge/cases/{{caseId}}
Accept: application/json

> {%
client.test("公开案例必须能匿名读取且保留防范建议", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.case_id === client.global.get("caseId"), "案例 ID 不一致");
    client.assert(d.advice.includes("官方"), "防范建议缺失");
});
%}

### 17. P0 知识库分页：新上线案例必须可检索
# @name listPublicCases
GET {{baseUrl}}/api/knowledge/cases?fraud_type=impersonation&page=1&page_size=100
Accept: application/json

> {%
client.test("案例分页必须包含刚上线的案例", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.total >= 1 && d.page === 1, "分页元数据错误");
    client.assert(d.items.some(c => c.case_id === client.global.get("caseId")), "上线案例未进入公开列表");
});
%}

### 18. P0 知识分类：分类计数必须来自上线案例
# @name knowledgeTypes
GET {{baseUrl}}/api/knowledge/types
Accept: application/json

> {%
client.test("分类列表必须返回正数案例计数", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(Array.isArray(response.body.data), "分类 data 必须为数组");
    response.body.data.forEach(t => client.assert(t.case_count >= 1, "空案例分类不应出现在公开分类中"));
});
%}

### 19. P0 案例归档：归档后不能继续匿名公开读取
# @name archiveCase
PATCH {{baseUrl}}/api/admin/knowledge/cases/{{caseId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"revision":{{caseRevision}},"fraud_type":"impersonation","title":"集成测试：冒充客服案例","content":"骗子冒充客服，以账户异常为由要求受害人转账到所谓安全账户。","advice":"不要转账，通过官方 App 或官方客服电话独立核实。","source_url":"https://example.com/integration-case","status":"archived"}

> {%
client.test("案例必须支持按 revision 归档", function () {
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(response.body.data.status === "archived", "案例未归档");
});
%}

### 20. P0 公开边界：已归档案例返回 404
# @name getArchivedCase
GET {{baseUrl}}/api/knowledge/cases/{{caseId}}
Accept: application/json

> {%
client.test("归档案例不能继续公开访问", function () {
