### 29. P0 热更新判定：新激活规则必须命中且证据可回放
# @name verifyNewRule
POST {{baseUrl}}/api/verify
Content-Type: application/json

{"content_type":"sms","content":"INTEGRATION_TEST_RULE：这是集成测试专用内容，请立即转账。","mode":"fast"}

> {%
client.test("新规则必须参与评分，且证据必须对应原文", function () {
    const d = response.body.data;
    client.assert(response.status === 200, `期望 200，实际 ${response.status}`);
    client.assert(d.versions.rule_version === client.global.get("activeRuleVersion"), "核验未使用新激活规则版本");
    const hit = d.hits.find(h => h.rule_id === client.global.get("ruleId"));
    client.assert(hit && hit.matched && hit.participates_in_score, "新规则未命中或未参与评分");
    client.assert(d.rule_score >= 45, "规则分未包含新规则权重");
    client.assert(hit.evidence.length > 0, "新规则命中缺少证据");
});
client.global.set("ruleHitTraceId", response.body.data.trace_id);
client.global.set("ruleHitTraceToken", response.body.data.trace_token);
%}

